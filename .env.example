APP_NAME=SMARTJOB
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/smartjob

# SMARTJOB_DB_* values take precedence; standard DB_* aliases are also supported.
SMARTJOB_DB_HOST=127.0.0.1
SMARTJOB_DB_PORT=3306
SMARTJOB_DB_NAME=smartjob_db
SMARTJOB_DB_USER=root
SMARTJOB_DB_PASSWORD=
SMARTJOB_APP_KEY=replace-with-a-random-secret-at-least-32-characters

# Email provider: mailjet, brevo, sendgrid, smtp
MAIL_PROVIDER=mailjet
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SMARTJOB
BREVO_API_KEY=
SENDGRID_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# SMS provider: textbee or twilio
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI writing provider. Keep all API keys only in the private local .env file.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=30
AI_STUDENT_DAILY_LIMIT=10
AI_EMPLOYER_DAILY_LIMIT=20

# Optional OpenAI provider.
# Apache PHP needs cURL, or HTTPS streams with OpenSSL and allow_url_fopen enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=30
# Legacy aliases for AI_*_DAILY_LIMIT; AI_* values take precedence.
OPENAI_STUDENT_DAILY_LIMIT=10
OPENAI_EMPLOYER_DAILY_LIMIT=20

# Account verification
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_REQUIRED=true
PHONE_VERIFICATION_REQUIRED=false

# Optional exact allowlist recipients for administrator provider tests
VERIFICATION_TEST_EMAIL=
VERIFICATION_TEST_PHONE=

# Optional private credential storage location outside the web root.
SMARTJOB_PRIVATE_STORAGE=
SMARTJOB_COMPANY_DOCUMENT_MAX_FILE_BYTES=8388608
SMARTJOB_COMPANY_DOCUMENT_MAX_BATCH_BYTES=33554432